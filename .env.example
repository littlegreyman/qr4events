# 复制为 .env 后按需修改；.env 与所有密钥文件已在 .gitignore 中，绝不提交。
# 生产必填项请用 scripts/preflight.py 自检（含 https/443/根路径/TZ 校验）。
# ============================================================

# ---- 必填（生产） ----
# 主密钥：派生手机号加密/HMAC 索引/令牌密钥。
# 【Serverless 必填】云函数无持久磁盘，留空会写 data/secret.key，重启后丢失，
# 导致历史报名手机号永久无法解密。务必显式设置一段长随机字符串并妥善备份。
SECRET_KEY=
# 后台管理员口令：留空则首次启动自动生成随机口令写入 data/initial_admin_password.txt
# 【Serverless 必填】同样因为无持久磁盘，留空会导致重启后口令丢失。
ADMIN_PASS=
ADMIN_USER=admin
# 对外公网地址：已备案短域名 + 标准 443，末尾不要斜杠、不要端口号、不要路径
# 二维码内容即 https://{本值}/p/{短活动ID}，改错会导致微信内被拦截。
PUBLIC_BASE_URL=https://your-domain.example

# ---- 数据库 ----
# 本地验证默认 SQLite；Serverless/生产改 PostgreSQL，业务代码与模型不变：
#   postgresql+psycopg2://user:pwd@host:5432/dbname
# SQLite 依赖本地磁盘，不适用于多副本 Serverless 部署。
DATABASE_URL=sqlite:///./data/app.db

# ---- 运行 ----
# 阶段判定强制 Asia/Shanghai，请勿修改（容器 TZ 也须同值）
APP_TZ=Asia/Shanghai
TZ=Asia/Shanghai
# 1=由 FastAPI 同源托管静态页面（推荐，C1/C2 共用）；
# 0=仅提供 API，需静态托管把 /p/* rewrite 到 participant.html 且会带来跨域/备案复杂度
SERVE_STATIC=1
# 是否解析 X-Forwarded-For。默认 0（不信任客户端可伪造头）。
# 设为 1 时必须同时填写 TRUSTED_PROXY_IPS（可信反向代理 IP/CIDR），并确保
# 代理会覆盖或安全追加 X-Forwarded-For；应用应禁止公网绕过代理直连。
TRUST_PROXY=0
TRUSTED_PROXY_IPS=
# API 请求体上限（字节）；默认 2 MiB，含无 Content-Length 的分块请求。
MAX_REQUEST_BYTES=2097152
# 管理端与静态托管不同源时才填，逗号分隔；同源部署留空
CORS_ORIGINS=
TOKEN_TTL=3600
RATE_LIMIT_GENERAL=180
RATE_LIMIT_SUBMIT=30
RATE_LIMIT_LOGIN=10
RATE_WINDOW=60
SHORT_ID_LEN=6
